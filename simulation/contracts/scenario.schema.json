{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "GymNote scenario v1",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "userGoal",
    "fixtureId",
    "startCaptureId",
    "captureIds",
    "allowedActionTypes",
    "maxSteps",
    "checks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "userGoal": {
      "type": "string",
      "minLength": 1
    },
    "fixtureId": {
      "const": "demo-v1"
    },
    "startCaptureId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "captureIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "allowedActionTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "inspect",
          "tap",
          "scroll",
          "input",
          "back",
          "stop"
        ]
      }
    },
    "maxSteps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "kind": {
            "enum": [
              "observation-only",
              "app-state",
              "manual"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
